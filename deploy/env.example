# Non-secret configuration (safe to commit as example)
REGIONGATE_API_ORIGIN=https://api.example.com:8443
REGIONGATE_EDGE_HOST=edge.example.com
REGIONGATE_EDGE_PORT=443
REGIONGATE_API_PORT=8443
REGIONGATE_VPNGATE_FEED_URL=https://www.vpngate.net/api/iphone/
REGIONGATE_XRAY_VERSION=25.x.x
REGIONGATE_XRAY_CONFIG_PATH=/etc/regiongate/xray/config.json
REGIONGATE_AGENT_SOCKET=/run/regiongate/agent.sock
REGIONGATE_NAMESPACE_PREFIX=rg-
REGIONGATE_EXIT_HEALTH_URL=https://ifconfig.co/json

# Secrets — inject via environment / secret manager. NEVER commit real values.
# REGIONGATE_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/regiongate
# REGIONGATE_TOKEN_SIGNING_KEY=
