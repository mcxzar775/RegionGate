[Unit]
Description=RegionGate Gateway Agent
After=network.target

[Service]
Type=simple
Environment=REGIONGATE_AGENT_DRY_RUN=1
Environment=REGIONGATE_AGENT_SOCKET=/run/regiongate/agent.sock
ExecStart=/opt/regiongate/.venv/bin/python -m regiongate_agent
Restart=on-failure
RuntimeDirectory=regiongate
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
